{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "languages": [
      "zh",
      "en"
    ]
  },
  "processing": {
    "profiles_dir": "/fixture/kb/horizon-profiles",
    "default_profile": "ai-kb-personal",
    "profile_settings": {
      "ai-kb-personal": {
        "threshold": null,
        "topic_dedup": true
      }
    }
  },
  "sources": {
